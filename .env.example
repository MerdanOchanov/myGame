# Copy to .env.local and fill in from Supabase Dashboard -> Settings -> API.
# The anon key is safe to expose in the client (security is enforced by RLS
# and the game-api Edge Function); NEVER put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
